{
  "name": "alan-fit-native",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "npm install && npx cap add ios --packagemanager SPM && npm run assets && npm run plist && npx cap sync ios",
    "assets": "node ios-assets.mjs",
    "plist": "node ios-plist.mjs",
    "ios": "npx cap open ios",
    "sync": "npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/camera": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}
